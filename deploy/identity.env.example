# Copy to /opt/11scat-web/identity.env and set real values only on the server.
# Never commit the real file.
SITE_PASSWORD=replace-me
AUTH_SESSION_SECRET=replace-with-a-long-random-value
IDENTITY_CODE_HASHES={}
TICKTICK_STORAGE_SECRET=replace-with-a-long-random-value
PEER_SERVER_PATH=/peerjs
TURN_URLS=turn:study.example.com:3478?transport=udp
TURN_USERNAME=replace-me
TURN_CREDENTIAL=replace-me
DATA_DIR=/data
# Pending task recovery runs only in the instance currently serving this origin.
TASK_SYNC_ORIGIN=https://study.11scat.xyz
# Set 1 to disable the independent task scheduler for diagnostics or isolated runs.
TASK_SYNC_DISABLED=0
VAPID_PUBLIC_KEY=replace-with-generated-public-key
VAPID_PRIVATE_KEY=replace-with-generated-private-key
VAPID_SUBJECT=mailto:admin@example.com
CLOUD_DRIVE_LIMIT_BYTES=5368709120
# Optional voice transcription. Use a Workers AI FREE plan account; no paid fallback.
# Token permissions: Workers AI Read + Edit. Never expose this token to the client.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_AI_TOKEN=
# Set true only after verifying Workers AI is on the Free plan in Cloudflare.
CLOUDFLARE_AI_FREE_PLAN_CONFIRMED=false
